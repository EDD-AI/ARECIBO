rules_version = '2';
// ORBITE — règles de sécurité Firestore.
// - saves/{uid}    : la progression complète, lisible et modifiable par son seul propriétaire.
// - profiles/{uid} : le profil public (pseudo, niveau, classement, système, présence), lisible par tout joueur
//                    connecté, modifiable par son seul propriétaire, avec des champs vérifiés.
// - friends/{a_b}  : une amitié entre deux joueurs (demande puis acceptation).
// - matches/{id}   : une partie en ligne (salon, puis manches) ; posts/{uid} le plateau publié
//                    par chaque joueur, rounds/{r} les plateaux retenus par l'hôte (écrits une fois).
// - daily/{d}_{uid} : le score du défi du jour, écrit une seule fois par joueur et par jour (v84).
// - rapports/{id}  : les bugs signalés par le bouton « ? » (v121). Tout le monde peut en écrire un,
//                    même sans compte, avec des champs vérifiés ; seul le créateur les lit.
// - limites/rapports : le compteur qui borne le nombre de rapports (et de captures) par période de 24 h.
// - admins/{uid}   : le créateur du jeu. Le document ne se crée qu'avec le code créateur, dont seule
//                    l'empreinte SHA-256 est ici ; le code lui-même n'est écrit nulle part dans le dépôt.
//                    Un seul créateur : config/createur garde son uid.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // Un seul créateur : le premier compte qui entre le code créateur le devient, en écrivant aussi
    // config/createur (son uid) dans le même envoi ; ensuite, même avec le code, personne d'autre.
    // Pour changer de compte : supprimer admins/<uid> et config/createur dans la console Firebase.
    match /admins/{uid} {
      allow read: if isMe(uid);
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(['cle'])
        && request.resource.data.cle is string && request.resource.data.cle.size() <= 64
        && hashing.sha256(request.resource.data.cle).toHexString().lower() == '3cbd5100482381349aae3b30d9c5c9f1651329f6d0bcf316561306382ffb3db2'
        && !exists(/databases/$(database)/documents/config/createur)
        && getAfter(/databases/$(database)/documents/config/createur).data.uid == uid;
      // Le code ne reste pas dans la base : aussitôt le document créé, le jeu le vide.
      allow update: if isMe(uid) && request.resource.data.keys().size() == 0;
    }
    match /config/createur {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Garde-fou contre l'envoi en masse (les rapports s'écrivent sans compte) : chaque rapport met à
    // jour ce compteur dans le même envoi. Au plus 200 rapports, dont 30 avec capture, par période de
    // 24 h (elle commence au premier rapport) ; au-delà, les rapports attendent sur les téléphones.
    match /limites/rapports {
      function q() { return request.resource.data; }
      function champs() {
        return q().keys().hasOnly(['debut', 'n', 'c', 'dernier', 'maj']) && q().keys().hasAll(['debut', 'n', 'c', 'dernier', 'maj'])
          && q().dernier is string && q().maj == request.time && q().n is int && q().c is int;
      }
      // Première fois, ou période finie : on repart de 1.
      function nouvelle() { return q().debut == request.time && q().n == 1 && q().c >= 0 && q().c <= 1; }
      allow create: if champs() && nouvelle();
      allow update: if champs() && (
        (request.time >= resource.data.debut + duration.value(1, 'd') && nouvelle())
        || (request.time < resource.data.debut + duration.value(1, 'd')
            && q().debut == resource.data.debut
            && q().n == resource.data.n + 1 && q().n <= 200
            && (q().c == resource.data.c || q().c == resource.data.c + 1) && q().c <= 30));
    }

    match /rapports/{id} {
      function r() { return request.resource.data; }
      function absent(k) { return !(k in r()); }
      function texte(k, max) { return r()[k] is string && r()[k].size() <= max; }
      // Une erreur de la liste : au plus 5, chacune un texte de 300 caractères au plus.
      function erreur(i) { return r().erreurs.size() <= i || (r().erreurs[i] is string && r().erreurs[i].size() <= 300); }
      // Le compteur (limites/rapports) a été écrit dans le même envoi, pour ce rapport-ci (un seul
      // rapport par envoi), et compte la capture s'il y en a une.
      function compte() {
        let l = getAfter(/databases/$(database)/documents/limites/rapports).data;
        return l.maj == request.time && l.dernier == id
          && (absent('capture')
              || (l.debut == request.time && l.c == 1)
              || (l.debut != request.time && l.c == get(/databases/$(database)/documents/limites/rapports).data.c + 1));
      }
      // Identifiant tiré au hasard par le jeu (20 lettres ou chiffres) : un renvoi ne crée pas de doublon.
      allow create: if id.matches('[A-Za-z0-9]{20}')
        && r().keys().hasOnly(['texte', 'capture', 'version', 'ecran', 'langue', 'appareil', 'taille', 'erreurs', 'etat', 'pseudo', 'uid', 'cree', 'regle'])
        && r().keys().hasAll(['texte', 'version', 'ecran', 'langue', 'appareil', 'taille', 'erreurs', 'cree', 'regle'])
        && texte('texte', 1000) && r().texte.size() >= 1
        && (absent('capture') || (texte('capture', 600000) && r().capture.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')))
        && r().version is int && r().version >= 1 && r().version <= 100000
        && texte('ecran', 24) && texte('langue', 8) && texte('appareil', 300) && texte('taille', 40)
        && r().erreurs is list && r().erreurs.size() <= 5
        && erreur(0) && erreur(1) && erreur(2) && erreur(3) && erreur(4)
        && (absent('etat') || texte('etat', 300))
        && (absent('pseudo') || texte('pseudo', 16))
        && (absent('uid') || (signedIn() && r().uid == request.auth.uid))
        && r().cree == request.time
        && r().regle == false
        && compte();
      // Le créateur lit les rapports et les marque réglés (rien d'autre ne change).
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && r().diff(resource.data).affectedKeys().hasOnly(['regle'])
        && r().regle is bool;
    }

    match /saves/{uid} {
      allow read, delete: if isMe(uid);
      allow write: if isMe(uid)
        && request.resource.data.keys().hasOnly(['data', 'updatedAt', 'v'])
        && request.resource.data.data is map;
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow delete: if isMe(uid);
      allow write: if isMe(uid)
        && request.resource.data.keys().hasOnly(['pseudo', 'tag', 'code', 'level', 'points', 'placed', 'games', 'wins', 'world', 'forge', 'updatedAt', 'seen', 'where'])
        && (!('seen' in request.resource.data) || request.resource.data.seen is int)
        && (!('where' in request.resource.data) || (request.resource.data.where is string && request.resource.data.where.size() <= 12))
        && request.resource.data.pseudo is string && request.resource.data.pseudo.size() <= 16
        && request.resource.data.tag is string && request.resource.data.tag.size() <= 6
        && request.resource.data.code is string && request.resource.data.code.size() == 6
        && request.resource.data.level is int && request.resource.data.level >= 1 && request.resource.data.level <= 1000
        && request.resource.data.points is int && request.resource.data.points >= 0 && request.resource.data.points <= 100000
        && request.resource.data.placed is bool
        && request.resource.data.games is int && request.resource.data.wins is int
        && request.resource.data.world is list && request.resource.data.world.size() <= 30
        && request.resource.data.forge is map;
    }

    match /daily/{id} {
      function nd() { return request.resource.data; }
      allow read: if signedIn();
      allow create: if signedIn()
        && nd().keys().hasOnly(['d', 'uid', 'pseudo', 'tag', 'score', 'win', 'rounds', 'law', 'at'])
        && nd().uid == request.auth.uid
        && nd().d is string && nd().d.size() == 10
        && id == nd().d + '_' + request.auth.uid
        && nd().pseudo is string && nd().pseudo.size() <= 16
        && nd().tag is string && nd().tag.size() <= 6
        && nd().score is int && nd().score >= 0 && nd().score <= 5000
        && nd().win is bool
        && nd().rounds is int && nd().rounds >= 1 && nd().rounds <= 60
        && nd().law is string && nd().law.size() <= 16;
    }

    match /friends/{pair} {
      function members() { return request.resource.data.members; }
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.members);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'from', 'status', 'at'])
        && members() is list && members().size() == 2
        && request.auth.uid in members()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.status == 'pending'
        && pair == members()[0] + '_' + members()[1]
        && members()[0] < members()[1];
      // Seul celui qui a reçu la demande peut l'accepter, et rien d'autre ne change.
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.auth.uid != resource.data.from
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }
    match /matches/{mid} {
      function m() { return resource.data; }
      function n() { return request.resource.data; }
      function member() { return request.auth.uid in get(/databases/$(database)/documents/matches/$(mid)).data.uids; }
      allow read: if signedIn();
      allow create: if signedIn()
        && n().keys().hasOnly(['mode', 'code', 'status', 'host', 'uids', 'seats', 'bracket', 'created', 'seed', 'beat', 'size'])
        && (!('size' in n()) || n().size == 2)
        && n().host == request.auth.uid
        && n().uids == [request.auth.uid]
        && n().status == 'waiting'
        && n().mode in ['ranked', 'private']
        && n().code is string && n().code.size() == 6;
      // Les membres font vivre la partie (lancement, battements, relais de l'hôte) ; un nouveau
      // venu ne peut que s'ajouter à un salon en attente.
      allow update: if signedIn() && n().uids.size() <= ('size' in m() ? m().size : 8) && (
        request.auth.uid in m().uids
        || (m().status == 'waiting'
            && request.auth.uid in n().uids
            && n().uids.size() == m().uids.size() + 1
            && n().diff(m()).affectedKeys().hasOnly(['uids', 'seats', 'beat']))
      );
      allow delete: if signedIn() && m().host == request.auth.uid;

      match /posts/{uid} {
        allow read: if signedIn();
        allow write: if isMe(uid) && member();
      }
      match /rounds/{r} {
        allow read: if signedIn();
        allow create: if signedIn() && member();
      }
    }
  }
}
